--StarterGui/Combat/Client/Dash

local dash = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local combat = ReplicatedStorage:WaitForChild("Combat")
local animations = combat:WaitForChild("Animations")
local sfxstorage = combat:WaitForChild("SFX")
local fxstorage = combat:WaitForChild("Fx")
local remotes = combat:WaitForChild("Remotes")

local player = game.Players.LocalPlayer
local character = player.Character

local frontcd = false
local sidecd = false
local cd = false
local evasive = false


function dash.Start()
	if character:FindFirstChild("Iframe") then
		if evasive == false then
			evasive = true
			
			remotes.Combat:FireServer({action = "evasive"})
			
			task.delay(10, function()
				evasive = false
			end)
		end
	end
	
	if cd == false and character:FindFirstChild("Stun") == nil then
		character.Humanoid.WalkSpeed = 0
		character.Humanoid.JumpPower = 0 
		character.Humanoid.JumpHeight = 0
		
		if (character.Humanoid.MoveDirection:Dot(workspace.CurrentCamera.CFrame.RightVector) > 0.75) and sidecd == false then	-- right
			cd = true
			sidecd = true

			local bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Name = "Dash"
			bodyVelocity.Velocity = player.Character.HumanoidRootPart.CFrame.RightVector * script.Speed:GetAttribute("Side")
			bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * math.huge
			bodyVelocity.Parent = player.Character.HumanoidRootPart

			local load = character.Humanoid:LoadAnimation(animations.Dash.Right)
			load.Priority = Enum.AnimationPriority.Action3
			load:Play()

			task.delay(.5, function()
				bodyVelocity:Destroy()
				cd = false
				
				character.Humanoid.WalkSpeed = game.StarterPlayer.CharacterWalkSpeed
				character.Humanoid.JumpPower = game.StarterPlayer.CharacterJumpPower
				character.Humanoid.JumpHeight = game.StarterPlayer.CharacterJumpHeight
				
				task.delay(2, function()
					sidecd = false
				end)
			end)

		elseif (character.Humanoid.MoveDirection:Dot(-workspace.CurrentCamera.CFrame.RightVector) > 0.75) and sidecd == false then	--left
			cd = true
			sidecd = true
			
			local bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Name = "Dash"
			bodyVelocity.Velocity = -player.Character.HumanoidRootPart.CFrame.RightVector * script.Speed:GetAttribute("Side")
			bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * math.huge
			bodyVelocity.Parent = player.Character.HumanoidRootPart

			local load = character.Humanoid:LoadAnimation(animations.Dash.Left)
			load.Priority = Enum.AnimationPriority.Action3
			load:Play()
			
			task.delay(.5, function()
				bodyVelocity:Destroy()
				cd = false
				
				character.Humanoid.WalkSpeed = game.StarterPlayer.CharacterWalkSpeed
				character.Humanoid.JumpPower = game.StarterPlayer.CharacterJumpPower
				character.Humanoid.JumpHeight = game.StarterPlayer.CharacterJumpHeight

				task.delay(2, function()
					sidecd = false
				end)
			end)

		elseif (character.Humanoid.MoveDirection:Dot(-workspace.CurrentCamera.CFrame.LookVector) > 0.75) and frontcd == false then	-- back
			cd = true
			frontcd = true

			local bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Name = "Dash"
			bodyVelocity.Velocity = -player.Character.HumanoidRootPart.CFrame.LookVector * script.Speed:GetAttribute("Back")
			bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * math.huge
			bodyVelocity.Parent = player.Character.HumanoidRootPart

			local load = character.Humanoid:LoadAnimation(animations.Dash.Back)
			load.Priority = Enum.AnimationPriority.Action3
			load:Play()
			load:AdjustSpeed(1.5)

			task.delay(.35, function()
				bodyVelocity:Destroy()
				cd = false
				
				character.Humanoid.WalkSpeed = game.StarterPlayer.CharacterWalkSpeed
				character.Humanoid.JumpPower = game.StarterPlayer.CharacterJumpPower
				character.Humanoid.JumpHeight = game.StarterPlayer.CharacterJumpHeight

				task.delay(3.5, function()
					frontcd = false
				end)
			end)
		else	-- front
			if frontcd == false then
				cd = true
				frontcd = true
				
				script.Speed.DO_NOT_EDIT.Value = script.Speed:GetAttribute("Front")

				local bodyVelocity = Instance.new("BodyVelocity")
				bodyVelocity.Name = "Dash"
				bodyVelocity.Velocity = player.Character.HumanoidRootPart.CFrame.LookVector * script.Speed:GetAttribute("Front")
				bodyVelocity.MaxForce = Vector3.new(50000, 0, 50000)
				bodyVelocity.Parent = player.Character.HumanoidRootPart

				local load = character.Humanoid:LoadAnimation(animations.Dash.Front)
				load.Priority = Enum.AnimationPriority.Action3
				load:Play()
				
				local sfx = sfxstorage.Dash:Clone()
				sfx.Parent = character.HumanoidRootPart
				sfx:Play()
				task.delay(sfx.TimeLength, function()
					sfx:Destroy()
				end)
				
				local fx = fxstorage.Dash:Clone()
				fx.Parent = workspace.Fx
				fx.CFrame = character.HumanoidRootPart.CFrame * CFrame.Angles(math.rad(90), math.rad(0), math.rad(0))
				fx.Size = Vector3.new(2, .25, 2)
				TweenService:Create(fx, TweenInfo.new(.2), {Transparency = 1, Size = Vector3.new(6, .25, 6)}):Play()
				task.delay(.2, function()
					fx:Destroy()
				end)
				
				local connection
				connection = RunService.RenderStepped:Connect(function()
					bodyVelocity.Velocity = player.Character.HumanoidRootPart.CFrame.LookVector * script.Speed.DO_NOT_EDIT.Value
				end)
				
				load.KeyframeReached:Connect(function(keyframe)
					task.wait()

					if character:FindFirstChild("Stun") then
						cd = false

						bodyVelocity:Destroy()
						load:Stop()

						task.delay(5, function()
							frontcd = false
						end)

						return
					end
					
					if keyframe == "Slow" then
