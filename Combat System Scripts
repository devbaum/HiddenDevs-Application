local block = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local combat = ReplicatedStorage:WaitForChild("Combat")
local animations = combat:WaitForChild("Animations")
local remotes = combat:WaitForChild("Remotes")
local configuration = combat:WaitForChild("Configuration")

local player = game.Players.LocalPlayer
local character = player.Character

local cd = false
local blocking = false


function block.Start()
	if cd == false then
		blocking = true
		cd = true
		
		remotes.Combat:FireServer({action = "block"})

		local load = character.Humanoid:LoadAnimation(animations.Block.Idle)
		load.Priority = Enum.AnimationPriority.Action4
		load:Play()

		repeat wait()
		until blocking == false
				
		load:Stop()
		
		remotes.Combat:FireServer({action = "unblock"})

		task.delay(configuration:GetAttribute("Block_Cooldown"), function()
			cd = false
		end)
	end
end

function block.Stop()
