local m1 = require(script.M1)
local dash = require(script.Dash)
local block = require(script.Block)
local state = require(script.State)

local mobilegui = script.Parent.MobileGui
local consolegui = script.Parent.ConsoleGui
local keyboardgui = script.Parent.KeyboardGui

local player = game.Players.LocalPlayer
local character = player.Character

local blocking = false


if UserInputService.KeyboardEnabled == true then
	keyboardgui.Visible = true
	mobilegui.Visible = false
	consolegui.Visible = false

elseif UserInputService.TouchEnabled == true then
	mobilegui.Visible = true
	keyboardgui.Visible = false
	consolegui.Visible = false
	
	repeat task.wait()
		if player:WaitForChild("PlayerGui").TouchGui.TouchControlFrame:FindFirstChild("JumpButton") then
			player:WaitForChild('PlayerGui').TouchGui.TouchControlFrame.JumpButton:Destroy()
		end
	until player:WaitForChild("PlayerGui").TouchGui.TouchControlFrame:FindFirstChild("JumpButton") == nil

elseif UserInputService.GamepadEnabled == true then
	consolegui.Visible = true
	mobilegui.Visible = false
	keyboardgui.Visible = false
end



UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if character:FindFirstChildOfClass("Tool") then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		if character:FindFirstChild("Block") == nil and character:FindFirstChild("Stun") == nil then
			local currentstate = state.GetState()
			m1.Start(currentstate)
		end
		
	elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonX then
		if character:FindFirstChild("Block") == nil and character:FindFirstChild("Stun") == nil then
			dash.Start()
		end
		
	elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonY then
		if character:FindFirstChild("Stun") == nil then
			block.Start()
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonY then
		block.Stop()
	end
end)


local jumppressing = false
local jumpcd = false
for _, v in pairs(mobilegui:GetChildren()) do
	if v:IsA("ImageButton") then
		v.MouseButton1Down:Connect(function()
			if v.Name == "M1" then
				if character:FindFirstChild("Block") == nil and character:FindFirstChild("Stun") == nil then
					local currentstate = state.GetState()
					m1.Start(currentstate)
				end
				
			elseif v.Name == "Jump" then
				jumppressing = true
				
				repeat task.wait()
					if jumpcd == false then
						jumpcd = true
						
						character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
						
						task.delay(.55, function()
							jumpcd = false
						end)
					end
				until jumppressing == false
				
			elseif v.Name == "Block" then
				if character:FindFirstChild("Stun") == nil then
					block.Start()
					blocking = true
				end
				
			elseif v.Name == "Dash" then
				if character:FindFirstChild("Block") == nil and character:FindFirstChild("Stun") == nil then
					dash.Start()
				end
			end
		end)
		
		v.MouseButton1Up:Connect(function()
			if v.Name == "Jump" then
				jumppressing = false
				
			elseif v.Name == "Block" then
				block.Stop()
			end
		end)
	end
end


character.ChildAdded:Connect(function(child)
	if child.Name == "Stun" then
		block.Stop()
		character.Humanoid.WalkSpeed = 0
		character.Humanoid.JumpPower = 0 
		character.Humanoid.JumpHeight = 0
	end
end)

character.ChildRemoved:Connect(function(child)
	if child.Name == "Stun" and character:FindFirstChild("Stun") == nil then
		character.Humanoid.WalkSpeed = game.StarterPlayer.CharacterWalkSpeed
		character.Humanoid.JumpPower = game.StarterPlayer.CharacterJumpPower
		character.Humanoid.JumpHeight = game.StarterPlayer.CharacterJumpHeight
	end
end)



